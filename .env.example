# Copy to .env and adjust. Nothing here is read except through cip.core.config.

# Which implementations the system is wired with. See RunMode in
# packages/core/src/cip/core/config.py. Nothing outside that module
# branches on this value.
#   offline - recorded fixtures, no network, what tests use
#   local   - real local stack (ollama, local vector store), see compose.yaml
#   cloud   - managed services, not implemented yet
CIP_RUN_MODE=offline

# Where offline fixtures, local indexes and other on-disk state live.
CIP_DATA_DIR=data
